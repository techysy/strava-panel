#!/bin/bash
# config_callback — save wizard settings (client_id etc) to strava.conf
# wizard/config field values come as bare env vars here
set -euo pipefail
APP_NAME="${TRIM_APPNAME:-strava}"
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME}}"
mkdir -p "${DATA_DIR}"

# 只有当提供了非空值时写入，避免清空已有凭据
[ -n "${client_id:-}" ] && sed -i "/^client_id=/d" "${DATA_DIR}/strava.conf" 2>/dev/null || true
[ -n "${client_secret:-}" ] && sed -i "/^client_secret=/d" "${DATA_DIR}/strava.conf" 2>/dev/null || true
[ -n "${refresh_token:-}" ] && sed -i "/^refresh_token=/d" "${DATA_DIR}/strava.conf" 2>/dev/null || true

{
  [ -n "${client_id:-}" ] && echo "client_id=${client_id}"
  [ -n "${client_secret:-}" ] && echo "client_secret=${client_secret}"
  [ -n "${refresh_token:-}" ] && echo "refresh_token=${refresh_token}"
} >> "${DATA_DIR}/strava.conf"

chmod 600 "${DATA_DIR}/strava.conf" 2>/dev/null || true
exit 0
