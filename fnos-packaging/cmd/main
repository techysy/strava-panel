#!/bin/bash
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-strava}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
DATA_DIR="${TRIM_PKGVAR:-/vol4/@appdata/${APP_NAME}}"

# 诊断日志（无条件记录，便于排查 fnOS 调用方式）
DIAG="${DATA_DIR}/strava-diag.log"
mkdir -p "${DATA_DIR}" 2>/dev/null
{
    echo "=== $(date '+%F %T') call: '${1:-<none>}' USER=$(id -un) UID=$(id -u) ==="
    echo "  PWD=$(pwd)"
    echo "  ARG1=${1:-<none>}"
    echo "  TRIM_APPDEST=${TRIM_APPDEST:-<unset>}"
    echo "  TRIM_PKGVAR=${TRIM_PKGVAR:-<unset>}"
    echo "  TRIM_APPNAME=${TRIM_APPNAME:-<unset>}"
    echo "  TRIM_SERVICE_PORT=${TRIM_SERVICE_PORT:-<unset>}"
    echo "  APP_DIR=${APP_DIR}"
    echo "  DATA_DIR=${DATA_DIR}"
} >> "${DIAG}" 2>&1

# 兼容两种部署布局（无条件记录 SRC_DIR 判定结果）
if [ -d "${APP_DIR}/server" ]; then
    SRC_DIR="${APP_DIR}/server"
    echo "  SRC_DIR=${SRC_DIR} (from APP_DIR/server)" >> "${DIAG}" 2>&1
elif [ -d "${APP_DIR}/target/server" ]; then
    SRC_DIR="${APP_DIR}/target/server"
    echo "  SRC_DIR=${SRC_DIR} (from APP_DIR/target/server)" >> "${DIAG}" 2>&1
else
    echo "  ERROR: server dir not found (APP_DIR=${APP_DIR})" >> "${DIAG}" 2>&1
    echo "ERROR: server dir not found" >&2; exit 1
fi

# Node.js 运行时（manifest install_dep_apps=nodejs_v24 提供）
APP_VOL="$(printf '%s' "${DATA_DIR}" | awk -F/ 'NF>2 && $2 ~ /^vol/ {print "/"$2; exit}')"
NODE_BIN=""
for cand in "/var/apps/nodejs_v24/target/bin/node" "${APP_VOL}/@appcenter/nodejs_v24/bin/node" "/vol4/@appcenter/nodejs_v24/bin/node"; do
    [ -x "$cand" ] && NODE_BIN="$cand" && break
done
[ -n "$NODE_BIN" ] || NODE_BIN="$(command -v node || echo /usr/bin/node)"
if [ ! -x "$NODE_BIN" ]; then
    echo "  ERROR: node not found (nodejs_v24 未安装?)" >> "${DIAG}" 2>&1
    echo "ERROR: Node.js runtime not found. Please install nodejs_v24 from fnOS App Center." >&2
    exit 1
fi
echo "  NODE_BIN=${NODE_BIN} ($("${NODE_BIN}" --version 2>/dev/null || echo unknown))" >> "${DIAG}" 2>&1

PORT="${TRIM_SERVICE_PORT:-20127}"
LOG="${DATA_DIR}/strava.log"
PID_FILE="${DATA_DIR}/strava.pid"

start() {
    echo "  start() begin, port=${PORT}" >> "${DIAG}" 2>&1
    mkdir -p "${DATA_DIR}" 2>/dev/null
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "  already running" >> "${DIAG}" 2>&1
        echo "already running (pid $(cat "${PID_FILE}"))"; return 0
    fi
    pkill -u strava -f "app\.js" 2>/dev/null || true
    pkill -f "strava/server/app.js" 2>/dev/null || true
    sleep 1
    if ss -tln 2>/dev/null | grep -q ":${PORT} "; then
        echo "  port ${PORT} busy" >> "${DIAG}" 2>&1
        echo "ERROR: port ${PORT} already in use"; return 1
    fi
    cd "${SRC_DIR}" || { echo "  cd ${SRC_DIR} FAILED" >> "${DIAG}" 2>&1; return 1; }
    echo "  launching: ${NODE_BIN} app.js" >> "${DIAG}" 2>&1
    SP_DATA_DIR="${DATA_DIR}" SP_PORT="${PORT}" SP_HOST="0.0.0.0" \
        DATA_DIR="${DATA_DIR}" PORT="${PORT}" \
        nohup "${NODE_BIN}" app.js >> "${LOG}" 2>&1 < /dev/null &
    PID=$!
    echo "${PID}" > "${PID_FILE}"
    echo "  launched pid=${PID}" >> "${DIAG}" 2>&1
    for i in $(seq 1 15); do
        if curl -sf "http://127.0.0.1:${PORT}/api/status" >/dev/null 2>&1; then
            echo "  health ok" >> "${DIAG}" 2>&1
            echo "started (pid ${PID})"; return 0
        fi
        sleep 1
    done
    echo "  health timeout; LOG tail:" >> "${DIAG}" 2>&1
    tail -5 "${LOG}" >> "${DIAG}" 2>&1
    echo "started, health check timed out"; return 0
}

stop() {
    if [ -f "${PID_FILE}" ]; then
        kill "$(cat "${PID_FILE}")" 2>/dev/null || true
        rm -f "${PID_FILE}"
    fi
    # 清理所有 strava 应用进程（兼容旧孤儿进程：cmdline 是 `node app.js`，不含路径/“strava”字样）
    # 限定 -u strava，避免误杀其他应用的 node 进程
    pkill -u strava -f "app\.js" 2>/dev/null || true
    pkill -f "strava/server/app.js" 2>/dev/null || true
    sleep 1
    # 兜底：若端口仍被占用，再按端口所在进程清理（限 strava 用户）
    if ss -tlnp 2>/dev/null | grep -q ":${PORT} "; then
        pkill -u strava -f "app\.js" 2>/dev/null || true
        sleep 1
    fi
    echo "stopped"
}

status() {
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "running (pid $(cat "${PID_FILE}"))"
        return 0
    elif curl -sf "http://127.0.0.1:${PORT}/api/status" >/dev/null 2>&1; then
        echo "running (port ${PORT})"
        return 0
    else
        echo "stopped"
        return 1
    fi
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
