{
  "name": "strava-panel-desktop",
  "productName": "StravaPanel",
  "version": "2.7.5",
  "description": "Strava 骑行数据面板 桌面托盘版 — Electron 托盘壳 + Node.js sidecar",
  "main": "main.js",
  "author": "techysy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.techysy.strava-panel",
    "productName": "StravaPanel",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "package.json",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "build/app",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.healthcare-fitness"
    },
    "dmg": {
      "artifactName": "StravaPanel-mac-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StravaPanel",
      "artifactName": "StravaPanel-win-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StravaPanel-win-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "techysy",
        "repo": "strava-panel"
      }
    ]
  }
}
